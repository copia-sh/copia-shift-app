rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // members/{email} が存在する = Copiaチームの登録メンバー
    function isTeamMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }

    // 招待コードなどの秘密設定。クライアントからは直接read/write不可(ルール内のget()でのみ参照)
    match /config/{docId} {
      allow read, write: if false;
    }

    match /members/{memberId} {
      // 自分の分、もしくは既にチームメンバーになっている人は全員分を読める
      allow read: if isTeamMember() ||
        (isSignedIn() && memberId == request.auth.token.email);

      // 新規参加: 本人のメールアドレスのドキュメントのみ作成可能。
      // 招待コードが config/settings の値と一致しないと作成できない(自己registration制限)
      allow create: if isSignedIn()
        && memberId == request.auth.token.email
        && request.resource.data.inviteCode ==
          get(/databases/$(database)/documents/config/settings).data.inviteCode;

      allow update, delete: if false;
    }

    match /shiftEntries/{entryId} {
      allow read: if isTeamMember();

      // 出勤希望日の新規登録: 本人のみ、必ず status = "desired" で作成
      allow create: if isTeamMember()
        && request.resource.data.memberId == request.auth.token.email
        && request.resource.data.status == 'desired';

      // 出勤希望日の削除: 本人の未確定(desired)の分のみ削除可能
      allow delete: if isTeamMember()
        && resource.data.memberId == request.auth.token.email
        && resource.data.status == 'desired';

      // 更新(確定/確定取り消し/種別・時間の編集): チームメンバーなら誰でも、誰の分でも可能
      allow update: if isTeamMember()
        && request.resource.data.memberId == resource.data.memberId;
    }
  }
}
