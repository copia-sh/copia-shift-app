rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(gid) {
      return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid);
    }

    // 在籍中(active)のメンバーだけを「メンバー」とみなす。退会は active:false で表す。
    function isMember(gid) {
      return signedIn()
        && exists(memberPath(gid))
        && get(memberPath(gid)).data.active == true;
    }

    function roleOf(gid) {
      return get(memberPath(gid)).data.role;
    }

    function isAdmin(gid) {
      return isMember(gid) && roleOf(gid) == 'admin';
    }

    // 確定・確定取消・却下ができる人
    function canConfirm(gid) {
      return isMember(gid) && (roleOf(gid) == 'admin' || roleOf(gid) == 'leader');
    }

    function isGroupOwner(gid) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid;
    }

    // 所属グループの逆引き。本人しか読み書きできない。
    match /users/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['groupIds']);
      allow delete: if false;
    }

    match /groups/{gid} {
      allow read: if isMember(gid);
      // セルフホスト前提なので、ログイン済みなら誰でもグループを作れる。
      // ただし ownerId は自分自身でなければならない。
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin(gid);
      allow delete: if false;

      // 招待コードを含むのでメンバーのみ読める
      match /settings/{docId} {
        allow read: if isMember(gid);
        // グループ作成直後、まだ自分のメンバードキュメントが無い状態で作るためオーナー判定を使う
        allow create: if isGroupOwner(gid);
        allow update: if isAdmin(gid);
        allow delete: if false;
      }

      match /members/{memberId} {
        allow read: if isMember(gid);

        // 参加は2通り:
        //  1) グループ作成者が自分自身を admin として作る
        //  2) 招待コードが settings/general と一致すれば自分自身を member として作る
        allow create: if signedIn() && memberId == request.auth.uid && (
          (request.resource.data.role == 'admin' && isGroupOwner(gid))
          ||
          (request.resource.data.role == 'member'
            && request.resource.data.inviteCode is string
            && request.resource.data.inviteCode.lower() ==
               get(/databases/$(database)/documents/groups/$(gid)/settings/general).data.inviteCode.lower())
        );

        // admin: 他人のロール変更・無効化・属性編集ができる。ただし自分自身のロールは変えられない
        //        (最後の admin が自分を降格してグループが操作不能になるのを防ぐ)
        // 一般:   自分の表示名と色だけ変えられる
        allow update: if isMember(gid) && (
          isAdmin(gid)
            ? !(memberId == request.auth.uid
                && request.resource.data.role != resource.data.role)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['displayName', 'color', 'role', 'active', 'shiftTarget', 'attributes'])
              && (!('attributes' in request.resource.data)
                  || request.resource.data.attributes is list)
            : (memberId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['displayName', 'color']))
        );

        // 退会は active:false で表すのでドキュメントは消さない
        allow delete: if false;
      }

      // カレンダー購読リンク。ドキュメントIDそのものが秘密のトークン(推測不可な乱数)。
      // Cloudflare Worker はサービスアカウント(管理者権限)でここを読むため、
      // このルールはブラウザ側の「発行・一覧・失効」UIだけに適用される。
      match /shareLinks/{token} {
        allow read: if isMember(gid) && (resource.data.memberId == request.auth.uid || isAdmin(gid));

        allow create: if isMember(gid)
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.statuses is list
          && request.resource.data.statuses.size() > 0
          && request.resource.data.statuses.hasOnly(['desired', 'confirmed'])
          && request.resource.data.typeKeys is list
          && request.resource.data.typeKeys.size() > 0;

        // 本人はいつでも失効でき、管理者は漏洩時などに代理で失効できる。
        allow delete: if isMember(gid) && (resource.data.memberId == request.auth.uid || isAdmin(gid));
        allow update: if false;
      }

      match /shifts/{shiftId} {
        allow read: if isMember(gid);

        // 希望の登録は本人のみ。admin だけは代理登録もできる。必ず desired で作る。
        allow create: if isMember(gid)
          && request.resource.data.status == 'desired'
          && (request.resource.data.memberId == request.auth.uid || isAdmin(gid));

        // 確定済みは削除できない(先に確定を取り消す)。
        // 未確定なら本人、または leader/admin が消せる。
        allow delete: if isMember(gid)
          && resource.data.status == 'desired'
          && (resource.data.memberId == request.auth.uid || canConfirm(gid));

        // memberId と date は誰も変更できない。
        // leader/admin は確定・確定取消を含めて変更できる。
        // 一般メンバーは、自分の未確定シフトを未確定のまま編集することだけできる。
        allow update: if isMember(gid)
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.date == resource.data.date
          && (
            canConfirm(gid)
            || (resource.data.memberId == request.auth.uid
                && resource.data.status == 'desired'
                && request.resource.data.status == 'desired')
          );
      }
    }
  }
}
